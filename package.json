{
  "name": "hiking-trail-mapper",
  "version": "3.0.1",
  "private": true,
  "description": "Static KML hiking trail mapper with a modular TypeScript core and single-file-compatible release.",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node tests/unit/run_unit_tests.mjs",
    "test:full": "./tests/run_full_test_suite.sh",
    "test:visual:capture": "./tests/visual/run_visual_capture.sh",
    "typecheck": "tsc --noEmit",
    "check:core": "node -e \"require('./src/core/index.ts')\"",
    "check:release-metadata": "python3 scripts/release/check_release_metadata.py",
    "release:check": "./tests/run_full_test_suite.sh",
    "sync:release": "./scripts/release/sync_release.sh",
    "sync:docs": "node scripts/release/sync_release_docs.mjs",
    "check:generated": "node scripts/build/build_release.mjs --check --outDir .vite-build",
    "dev": "vite --host 127.0.0.1 --open /",
    "build": "node scripts/build/build_release.mjs",
    "release:prepare": "./scripts/release/prepare_release.sh",
    "version:bump": "node scripts/release/bump_version.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "lucide": "^1.24.0"
  }
}
